{
  "model": "openai:gpt-5.5",
  "model_proxy_url": "http://127.0.0.1:8765",
  "max_turns": 0,
  "max_prompt_tokens": 0,
  "max_prompt_cost_usd": 0,
  "reasoning": "medium",
  "reasoning_summary": "none",
  "web_search": "off",
  "color_theme": "dark",
  "agent": "auto",
  "agents": {
    "focused_review": {
      "description": "Review a focused change when the parent needs an independent correctness check.",
      "allowed_tools": ["read_file", "shell"],
      "mcp_tools": "read_only",
      "prompt": "Review the requested change and report concrete findings first."
    }
  },
  "mcp": {
    "enable": false,
    "proxy": "http://127.0.0.1:8766",
    "local": {
      "enable": false
    }
  },
  "lsp": {
    "enable": false,
    "serena": {
      "enable": false
    }
  }
}
